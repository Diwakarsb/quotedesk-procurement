# ── Model provider ────────────────────────────────────────────────────────
# The app is provider-agnostic. It tries providers in PROVIDER_ORDER and uses
# the first one with a working key, so a dead key never breaks the demo.

PROVIDER_ORDER=openrouter,gemini,eden

# Google AI Studio — https://aistudio.google.com/apikey
# Recurring free tier, native multimodal (handles the photo + handwriting).
# Key looks like: AIzaSy...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Eden AI — https://app.edenai.run/settings/api-keys
# One-time free credits. Key looks like: sk-eden-live-...
EDENAI_API_KEY=
EDEN_PROVIDER=google

# OpenRouter — https://openrouter.ai/keys
# Free multimodal tier, no card. Key looks like: sk-or-v1-...
# 50 free-model requests/day until you've bought $10 of credit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
# For a genuinely fast pipeline on Vercel Hobby's 60s ceiling, point the same
# OpenAI-compatible adapter at Groq instead (needs a free key from console.groq.com):
#   OPENROUTER_BASE_URL=https://api.groq.com/openai/v1
#   OPENROUTER_API_KEY=gsk_...
#   OPENROUTER_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Persistence (production) ──────────────────────────────────────────────
# The RFx draft, faked outbox and analyst history need a writable store.
# Locally they use data/_runtime/. On Vercel the filesystem is read-only —
# add the "Upstash for Redis" integration (Vercel dashboard → Storage) and it
# injects these automatically. Either naming works:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Fast text lane (optional, recommended for Vercel) ─────────────────────
# The analyst (2 calls) and RFx co-pilot are text-only. Point them at a fast
# model so both finish well inside Vercel's 60s function limit; extraction
# stays on the multimodal provider above. Groq is free and ~1s:
#   FAST_API_KEY=gsk_...           (console.groq.com/keys)
#   FAST_BASE_URL=https://api.groq.com/openai/v1
#   FAST_MODEL=openai/gpt-oss-120b
FAST_API_KEY=
FAST_BASE_URL=
FAST_MODEL=
