# ── Model provider ────────────────────────────────────────────────────────
# The app is provider-agnostic. It tries providers in PROVIDER_ORDER and uses
# the first one with a working key. One multimodal model serves every route
# (extraction, RFx co-pilot, analyst).

PROVIDER_ORDER=gemini,openrouter,eden

# Google AI Studio — https://aistudio.google.com/app/apikey  →  "Create API key".
# Free, recurring, multimodal. Keys issued from mid-2026 start with "AQ." and
# use the Interactions API (the app handles this). Free tier is ~20 requests
# per minute per model, so the app falls through a list of model names.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_THINKING=minimal          # reasoning budget: minimal | low | medium | high

# OpenRouter — https://openrouter.ai/keys  (key looks like: sk-or-v1-...)
# Faster (google/gemini-2.5-flash ~2-4s) but needs a few $ of credit at
# https://openrouter.ai/settings/credits — PDF inputs require a $0.50 minimum.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_BASE_URL=            # override to hit any OpenAI-compatible host

# Eden AI — https://app.edenai.run/settings/api-keys  (key: sk-eden-live-...)
EDENAI_API_KEY=
EDEN_PROVIDER=google

# ── Persistence (production) ──────────────────────────────────────────────
# The RFx draft, faked outbox and analyst history need a writable store.
# Locally they use data/_runtime/. On Vercel the filesystem is read-only —
# add the "Upstash for Redis" integration (Vercel dashboard → Storage) and it
# injects these automatically. Either naming works:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
