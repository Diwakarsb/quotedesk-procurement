# ── Model provider ────────────────────────────────────────────────────────
# The app is provider-agnostic. It tries providers in PROVIDER_ORDER and uses
# the first one with a working key, so a dead key never breaks the demo.
# One multimodal model serves every route (extraction, RFx co-pilot, analyst).

PROVIDER_ORDER=openrouter,gemini,eden

# Google AI Studio — https://aistudio.google.com/apikey
# Recurring free tier, native multimodal. Key looks like: AIzaSy...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Eden AI — https://app.edenai.run/settings/api-keys
# One-time free credits. Key looks like: sk-eden-live-...
EDENAI_API_KEY=
EDEN_PROVIDER=google

# OpenRouter — https://openrouter.ai/keys  (key looks like: sk-or-v1-...)
# google/gemini-2.5-flash is fast (~2-4s), multimodal, and ~$0.08 per full demo
# run — comfortably inside Vercel's 60s function limit. Needs a few $ of credit
# at https://openrouter.ai/settings/credits. Free multimodal models exist
# (minimax/minimax-m3:free) but are too slow/rate-limited for a live deploy.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_BASE_URL=            # override to hit any OpenAI-compatible host

# ── Persistence (production) ──────────────────────────────────────────────
# The RFx draft, faked outbox and analyst history need a writable store.
# Locally they use data/_runtime/. On Vercel the filesystem is read-only —
# add the "Upstash for Redis" integration (Vercel dashboard → Storage) and it
# injects these automatically. Either naming works:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
