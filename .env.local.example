# ── Model provider ────────────────────────────────────────────────────────
# The app is provider-agnostic. It tries providers in PROVIDER_ORDER and uses
# the first one with a working key, so a dead key never breaks the demo.

PROVIDER_ORDER=openrouter,gemini,eden

# Google AI Studio — https://aistudio.google.com/apikey
# Recurring free tier, native multimodal (handles the photo + handwriting).
# Key looks like: AIzaSy...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Eden AI — https://app.edenai.run/settings/api-keys
# One-time free credits. Key looks like: sk-eden-live-...
EDENAI_API_KEY=
EDEN_PROVIDER=google

# OpenRouter — https://openrouter.ai/keys
# Free multimodal tier, no card. Key looks like: sk-or-v1-...
# 50 free-model requests/day until you've bought $10 of credit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
